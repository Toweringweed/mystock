# ─── 数据库 ───────────────────────────────────────────
POSTGRES_USER=mystock
POSTGRES_PASSWORD=mystock123
POSTGRES_DB=mystock_db
DATABASE_URL=postgresql+asyncpg://mystock:mystock123@postgres:5432/mystock_db

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── LLM 路由 ────────────────────────────────────────
# 优先级: OpenRouter (DeepSeek 主) → OpenAI → Anthropic
# OPENROUTER 是主入口,以便统一计费 + 支持多家模型(DeepSeek/Gemini/Claude/GPT 等)
LLM_PROVIDER_PRIMARY=openrouter

# ── OpenRouter (主) — DeepSeek V3 主用,Sonnet 4.6 用于深度分析 (L2)
# 注册 https://openrouter.ai/ 获取 key
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 默认模型 — 用于报告生成、L2 深度分析、翻译、供应链抽取
OPENROUTER_MODEL=deepseek/deepseek-chat
# 资讯流水线打分用(L1 分诊),便宜且快 — DeepSeek 也很便宜,用同款够了
OPENROUTER_FAST_MODEL=deepseek/deepseek-chat
# 重大决策(L2 深度分析)— 用更强模型时填入,如 anthropic/claude-sonnet-4.6
# 留空则一律用 OPENROUTER_MODEL
OPENROUTER_DEEP_MODEL=

# ── OpenAI (备用)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic (备用)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# ── DeepSeek 直连 (主入口, 比 OpenRouter 便宜无抽成)
# 实测 2026-05-07: v4-flash / v4-pro 文档预告但 API 静默返回空, 暂不可用
# 当前使用 deepseek-chat (V3.x); 2026/07/24 弃用前需迁移到 v4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_DEEP_MODEL=deepseek-reasoner

# ─── 数据源 ───────────────────────────────────────────
# Tushare Pro (注册获取: https://tushare.pro)
TUSHARE_TOKEN=

# 富途 OpenD 本地部署 (港股实时行情)
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# ─── 资讯爬虫:X.com (Twitter) — Playwright + 副号 cookies 方案 ─────
# 推荐使用副号(年龄 > 30 天),避免主号被风控
# 提取方法: 浏览器登录 X → F12 → Application → Cookies → 复制 auth_token 和 ct0
X_AUTH_TOKEN=
X_CT0_TOKEN=
# 抓取频率(分钟); 防风控建议 >= 30; 抓取窗口随机化
X_CRAWL_INTERVAL_MINUTES=30
# 关注的 KOL 用户名列表(以 @ 开头,逗号分隔; 不超过 25 个)
X_KOL_HANDLES=dylan522p,SKundojjala,FabricatedKnwl,doodles,Asianometry,TrendForce,SemiAnalysis_,cnLedger,sinocism,WallStreetNews,cailianshepress,unusual_whales,charliebilello,JeffSnider,LizAnnSonders,DrJimFan,sama,karpathy

# Twitter API v2 (旧字段,保留兼容; 优先使用 Playwright)
TWITTER_BEARER_TOKEN=

# ─── 资讯爬虫:其他源 ─────────────────────────────────
# 巨潮 RSS 仅拉自选股公告(P0)
CNINFO_RSS_ENABLED=true
CNINFO_RSS_INTERVAL_MINUTES=5

# 雪球热议(自选股)
XUEQIU_ENABLED=false
XUEQIU_INTERVAL_MINUTES=15

# ─── 翻译 (英文资讯) ────────────────────────────────
# 标题 + 摘要都翻译; 保留原文 original_title 字段
NEWS_TRANSLATION_ENABLED=true
NEWS_TRANSLATION_TARGET_LANG=zh-CN

# ─── 应用配置 ─────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
LOG_LEVEL=INFO

# 每日 AI 报告生成时间 (上海时间,24 小时制)
REPORT_GENERATION_HOUR=16
REPORT_GENERATION_MINUTE=30

# 资讯爬取兜底间隔(小时) — 仅作为 P0 频率分层之外的全量回扫保险
NEWS_CRAWL_INTERVAL_HOURS=3

# ─── 资讯推送(企业微信群机器人) ──────────────────────
# 群机器人 webhook,例:https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WECHAT_WORK_WEBHOOK_URL=
NOTIFY_URGENT_ENABLED=true
NOTIFY_IMPORTANT_ENABLED=true
NOTIFY_DAILY_SUMMARY_ENABLED=true
# L2 深度分析仅站内展示,不推送企业微信
NOTIFY_L2_DEEP_ANALYSIS_ENABLED=false

# ─── 桌面 Claude MCP 只读连接 ────────────────────────
POSTGRES_RO_USER=mystock_readonly
POSTGRES_RO_PASSWORD=mystock_ro_changeme

# 行情更新间隔(秒,仅交易时段生效)
QUOTE_UPDATE_INTERVAL_SECONDS=15

# ─── 前端 ─────────────────────────────────────────────
SERVER_API_URL=http://localhost:8500
