# ─── 数据库 ───────────────────────────────────────────
POSTGRES_USER=mystock
POSTGRES_PASSWORD=mystock123
POSTGRES_DB=mystock_db
DATABASE_URL=postgresql+asyncpg://mystock:mystock123@postgres:5432/mystock_db

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── AI 分析 (OpenRouter 优先，OpenAI/Anthropic 备用) ─────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Haiku 模型（资讯流水线打分用，便宜且快）
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001


# ─── 数据源 ───────────────────────────────────────────
# Tushare Pro (注册获取: https://tushare.pro)
TUSHARE_TOKEN=7455956b44dd5d5f5f46448968e832a3633a208f8aaf9573f548c789

# 富途 OpenD 本地部署 (港股实时行情)
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# ─── 资讯爬虫 ─────────────────────────────────────────
# Twitter API v2 (可选，不填则使用 Playwright 模拟)
TWITTER_BEARER_TOKEN=

# ─── 应用配置 ─────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
LOG_LEVEL=INFO

# 每日 AI 报告生成时间 (上海时间，24小时制)
REPORT_GENERATION_HOUR=16
REPORT_GENERATION_MINUTE=30

# 资讯爬取间隔（小时）
NEWS_CRAWL_INTERVAL_HOURS=3

# ─── 资讯推送（企业微信群机器人） ──────────────────────
# 群机器人 webhook，例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WECHAT_WORK_WEBHOOK_URL=
NOTIFY_URGENT_ENABLED=true
NOTIFY_IMPORTANT_ENABLED=true
NOTIFY_DAILY_SUMMARY_ENABLED=true

# ─── 桌面 Claude MCP 只读连接 ────────────────────────
# 由 backend/db/init_readonly_role.sql 创建的只读账号密码
# 与桌面 Claude 的 ~/Library/Application Support/Claude/claude_desktop_config.json 保持一致
POSTGRES_RO_USER=mystock_readonly
POSTGRES_RO_PASSWORD=mystock_ro_changeme

# 行情更新间隔（秒，仅交易时段生效）
QUOTE_UPDATE_INTERVAL_SECONDS=15

# ─── 前端 ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8010
